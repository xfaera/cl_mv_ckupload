{
  "name": "Upload-Tool",
  "showPdfViewer": true,
  "extract": {
    "section": "Vereine und Verbände",
    "include": ["Edermünde"],
    "exclude": ["Gudensberg", "Niedenstein"],
    "format": {
      "section": { "s": 17, "b": true },
      "municipality": { "s": 17, "b": true },
      "heading": { "s": 15, "b": true }
